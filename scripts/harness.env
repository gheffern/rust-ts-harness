# ==============================================================================
# Central Harness Configuration (sourced by scripts/*.sh)
# ==============================================================================
# Populate or update via ./scripts/init.sh

PROJECT_NAME="rust-ts-harness"
PROJECT_SLUG="rust-ts-harness"

# Inner repository submodule directory relative to repo root (holds all project code)
INNER_DIR="app"
# Template inner workspace used before init.sh materializes INNER_DIR
TEMPLATE_INNER_DIR="templates/inner-project"
# Optional web directory relative to INNER_DIR (auto-detected if empty: web, frontend, or .)
WEB_SUBDIR=""

# Git commit author identity
GIT_AUTHOR_NAME="Graham Heffern"
GIT_AUTHOR_EMAIL="gheffern@gmail.com"

# Optional local bare/checkout path for inner submodule sync in run-pr.sh
INNER_LOCAL_UPSTREAM=""

# Optional license invariant for inner Cargo.toml (leave empty to skip)
INNER_LICENSE=""

# Optional container execution (--container flag; native host execution is default)
CONTAINER_IMAGE="localhost/rust-ts-harness-toolchain:latest"
PLAYWRIGHT_IMAGE="mcr.microsoft.com/playwright:v1.60.0-jammy"

# E2E defaults
E2E_BASE_URL="http://127.0.0.1:8080"
E2E_HEALTH_PATH="/api/v1/health"
