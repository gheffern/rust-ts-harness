{
  "name": "@rust-ts-harness/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal TypeScript + Vite + Vitest + Biome web frontend shell",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check src tests e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
